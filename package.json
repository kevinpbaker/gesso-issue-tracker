{
  "name": "gesso-issue-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "phase0:markdown": "node --experimental-strip-types scripts/phase0-markdown.ts"
  },
  "dependencies": {
    "gesso-components": "^0.4.2",
    "gesso-core": "^0.4.2",
    "gesso-framework": "^0.4.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@webgpu/types": "^0.1.71",
    "gesso-devtools": "^0.4.2",
    "gesso-testing": "^0.4.2",
    "gesso-vite-plugin": "^0.4.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.3",
    "micromark-extension-gfm": "^3.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "gesso-core": "link:../gesso/packages/core",
      "gesso-framework": "link:../gesso/packages/framework",
      "gesso-components": "link:../gesso/packages/components",
      "gesso-testing": "link:../gesso/packages/testing",
      "gesso-devtools": "link:../gesso/packages/devtools",
      "gesso-vite-plugin": "link:../gesso/packages/vite-plugin"
    }
  }
}
